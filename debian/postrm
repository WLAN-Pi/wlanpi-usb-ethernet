#!/bin/sh
set -e

# Detect config.txt location
if [ -f "/boot/firmware/config.txt" ]; then
    CONFIG_FILE="/boot/firmware/config.txt"
elif [ -f "/boot/config.txt" ]; then
    CONFIG_FILE="/boot/config.txt"
else
    CONFIG_FILE=""
fi

case "$1" in
    remove|purge)
        # Stop the gadget. The unit file is already removed by the time postrm
        # runs, but systemd still has it loaded until daemon-reload, so stop
        # and disable work here.
        systemctl stop usb-ethernet-gadget.service >/dev/null 2>&1 || true
        systemctl disable usb-ethernet-gadget.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/multi-user.target.wants/usb-ethernet-gadget.service

        # Remove the bare dtoverlay=dwc2 line the postinst added to [cm4].
        # Keep the "dtoverlay=dwc2,dr_mode=host" form used by the host image.
        if [ -n "$CONFIG_FILE" ]; then
            sed -i '/^dtoverlay=dwc2$/d' "$CONFIG_FILE"
        fi

        # Drop the gadget interfaces from Avahi's allow-interfaces whitelist.
        # postinst appended them as ", usb0" / ", usb1", so remove those forms
        # and leave the rest of the list untouched.
        AVAHI_CONF="/etc/avahi/avahi-daemon.conf"
        if [ -f "$AVAHI_CONF" ] && grep -q '^allow-interfaces=' "$AVAHI_CONF"; then
            sed -i '/^allow-interfaces=/ s/, usb0//g; /^allow-interfaces=/ s/, usb1//g' "$AVAHI_CONF"
        fi

        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
